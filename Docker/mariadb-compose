version: '3.7'
services: 
    mariadb:
        image: mariadb:latest
        command: --default-authentication-plugin=mysql_native_password
        env_file:
          - ./config/mariadb.env
        ports: 
          - 3306:3306
        volumes: 
            - mariadb_data:/var/lib/mysql

    adminer_container:
        image: adminer:latest
        environment: 
            ADMINER_DEFAULT_SERVER: mariadb
            ADMINER_DESIGN: dracula
        ports: 
          - 8080:8080


volumes: 
    mariadb_data: 
